<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="KurtDhylanMotoShopInventory.CartPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#0B0B0D" Title="Order / Payment">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="20,20,20,8" Spacing="4">
            <Label Text="ORDER / PAYMENT" FontSize="26" FontAttributes="Bold" TextColor="White"/>
            <Label Text="Review your order before checkout" FontSize="12" TextColor="#9B9BA3"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="CartView" Margin="20,5">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="14" Margin="0,0,0,8" CornerRadius="16" BackgroundColor="#17171B" BorderColor="#2A2A2F" HasShadow="False">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="{Binding Price, StringFormat='₱{0:N2} each'}" FontSize="11" TextColor="#9B9BA3"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" VerticalOptions="Center" TextColor="White"/>
                            <Label Grid.Column="2" Text="{Binding Amount, StringFormat='₱{0:N2}'}" VerticalOptions="Center" FontAttributes="Bold" TextColor="#F20D18"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Padding="20,10,20,20" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="PAYMENT" TextColor="#9B9BA3"/>
                <Entry Grid.Column="1" x:Name="PaymentEntry" WidthRequest="150" Placeholder="₱0.00" Keyboard="Numeric"
                       TextColor="White" PlaceholderColor="#77777E" HorizontalTextAlignment="End"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="CHANGE" TextColor="#9B9BA3"/>
                <Label Grid.Column="1" x:Name="ChangeLabel" Text="₱0.00" TextColor="White" FontAttributes="Bold"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="TOTAL ORDER" FontAttributes="Bold" TextColor="White"/>
                <Label Grid.Column="1" x:Name="TotalLabel" Text="₱0.00" FontSize="22" FontAttributes="Bold" TextColor="#F20D18"/>
            </Grid>
            <Button Text="CHECK OUT  →" Clicked="CheckoutClicked" HeightRequest="55"
                    BackgroundColor="#F20D18" TextColor="White" CornerRadius="16"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
