<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="KurtDhylanMotoShopInventory.ServiceEditorPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#0B0B0D" Title="Service">
    <VerticalStackLayout Padding="20" Spacing="14">
        <Label Text="SERVICE / LABOR" FontSize="25" FontAttributes="Bold" TextColor="White"/>
        <Entry x:Name="LaborEntry" Placeholder="Labor / service name" TextColor="White" PlaceholderColor="#77777E"/>
        <Entry x:Name="PriceEntry" Placeholder="Price" Keyboard="Numeric" TextColor="White" PlaceholderColor="#77777E"/>
        <Button Text="SAVE SERVICE" Clicked="SaveClicked" BackgroundColor="#F20D18" TextColor="White" CornerRadius="15" HeightRequest="52"/>
    </VerticalStackLayout>
</ContentPage>
